#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/cloudflare-ddns

start_service() {
	local enabled
	config_load cloudflare-ddns
	config_get enabled settings enabled "0"

	[ "$enabled" = "1" ] || {
		echo "cloudflare-ddns: đang tắt trong cấu hình, không khởi động"
		return 0
	}

	procd_open_instance "cloudflare-ddns"
	procd_set_param command "$PROG" daemon
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 0
	procd_set_param pidfile /var/run/cloudflare-ddns.pid
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "cloudflare-ddns"
	procd_add_raw_trigger "interface.*.up" 5000 /etc/init.d/cloudflare-ddns reload
}

reload_service() {
	stop
	start
}

update() {
	"$PROG" force
}

extra_command "update" "Cập nhật DNS ngay lập tức"
